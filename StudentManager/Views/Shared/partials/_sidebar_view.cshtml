@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    //string modulePage = HttpContext.Current.Request.Url.Host.ToString();
    //modulePage = modulePage?.Trim();
    //string modulePage = HttpContext.Request.Query["c"]?.ToLower();
    int id = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? throw new InvalidOperationException());
    var name = User.FindFirstValue(ClaimTypes.Name);
}
<aside class="main-sidebar sidebar-dark-orange elevation-4">
    <!-- Brand Logo -->
    <a href="@Url.Action("Index", "Home")" class="brand-link">
        <img src="~/img/Logo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-5" style="opacity: .8">
        <span class="brand-text font-weight-light">Admin - BTEC FPT</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar user panel (optional) -->
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <img src="~/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
            </div>
            <div class="info row">
                <div class="col">
                    <a href="#" class="d-block">@name</a>
                </div>
            </div>
            <br/>
            <div class="col">
                <a asp-action="logout" asp-controller="LoginForm" asp-route-id="@id" class="btn btn-danger">Logout</a>
            </div>
        </div>


        <!-- SidebarSearch Form -->
        <div class="form-inline">
            <div class="input-group" data-widget="sidebar-search">
                <input class="form-control form-control-sidebar" type="search" placeholder="Search" aria-label="Search">
                <div class="input-group-append">
                    <button class="btn btn-sidebar">
                        <i class="fas fa-search fa-fw"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu" data-accordion="false">
                <!-- Add icons to the links using the .nav-icon class
                with font-awesome or any other icon font library -->
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Home")" class="nav-link @(ViewBag.ModulePage == "dashboard" ? "active" : null)">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>
                            Dashboard
                        </p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Departments")" class="nav-link @(ViewBag.ModulePage == "Departments" ? "active" : null)">
                        <i class="nav-icon fas fa-th"></i>
                        <p>
                            Departments
                        </p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Courses")" class="nav-link @(ViewBag.ModulePage == "Courses" ? "active" : null)">
                        <i class="nav-icon fas fa-copy"></i>
                        <p>
                            Course
                        </p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Groups")" class="nav-link @(ViewBag.ModulePage == "Groups" ? "active" : null)">
                        <i class="nav-icon fas fa-users"></i>
                        <p>
                            class
                        </p>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Accounts" asp-action="Index" asp-route-role="" class="nav-link @(ViewBag.ModulePage == "Accounts" ? "active" : null)">
                        <i class="nav-icon fas fa-user-circle"></i>
                        <p>
                            Accounts
                        </p>
                    </a>
                </li>
                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                {
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "GroupStudents")" class="nav-link @(ViewBag.ModulePage == "Attendances" ? "active" : null)">
                            <i class="nav-icon fas fa-edit"></i>
                            <p>
                                Attendances
                            </p>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                {
                    <li class="nav-header">View</li>
                    <li class="nav-item ">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-user-tag"></i>
                            <p>
                                Roles
                                <i class="right fas fa-angle-left"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview" style="@(ViewBag.ModulePage == "Students" || ViewBag.ModulePage == "Teachers" || ViewBag.ModulePage == "Admins" ? "display: block" : "display:none");">
                            <li class="nav-item">
                                <a asp-controller="Accounts" asp-action="Index" asp-route-role="Students" class="nav-link @(ViewBag.ModulePage == "Students" ? "active" : null)">
                                    <i class="fas fa-user nav-icon"></i>
                                    <p>Students</p>
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Accounts" asp-action="Index" asp-route-role="Teachers" class="nav-link @(ViewBag.ModulePage == "Teachers" ? "active" : null)">
                                        <i class="fas fa-chalkboard-teacher nav-icon"></i>
                                        <p>Teachers</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Accounts" asp-action="Index" asp-route-role="Admins" class="nav-link @(ViewBag.ModulePage == "Admins" ? "active" : null)">
                                        <i class="far fas fa-users-cog nav-icon"></i>
                                        <p>Admins</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </nav>
        <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
</aside>